# Copy of what scripts/setup-workspace.sh generates for the default workspace.
# Put overrides in .env.local, which loads after .env.
WORKSPACE=padvinder
DATABASE_URL=postgres://padvinder:padvinder@localhost:54329/padvinder_padvinder
TEST_DATABASE_URL=postgres://padvinder:padvinder@localhost:54329/padvinder_padvinder_test
API_PORT=4100
MOBILE_PORT=4101
PORTAL_PORT=4102
STORYBOOK_PORT=4103
ALLOWED_ORIGINS=http://localhost:4101,http://localhost:4102
# Setup generates a random secret (openssl rand -hex 32). The API needs at least 32 characters,
# so it refuses to start with this placeholder: a copy of this file never runs on a public value.
AUTH_SECRET=replace-me
# The worker reads PUBLIC_ORIGIN and the mail settings below too (it sends the queued mails),
# and refuses to start without them.
PUBLIC_ORIGIN=http://localhost:4101
SMTP_HOST=localhost
SMTP_PORT=54325
MAIL_FROM=PadVinder <noreply@padvinder.test>
# Optional text before the subject of every mail; staging sets "[STAGING]". Leave it out locally.
# MAIL_SUBJECT_PREFIX=
LOGIN_RATE_LIMITS=off
MAILPIT_URL=http://localhost:54326

# Optional, with defaults. Not written to .env.
# Address the API listens on (default ::).
# API_HOST=::
# Git commit shown by the API (default dev).
# GIT_COMMIT=dev
# Minimum app version the API accepts (default 2027.0.0).
# MIN_APP_VERSION=2027.0.0
# Version of the mobile build (default: the version in apps/mobile/package.json).
# PADVINDER_APP_VERSION=2027.0.0
# CI run number shown next to the version (default dev).
# PADVINDER_BUILD_NUMBER=
# Directories with the built mobile and portal apps, served by the API.
# MOBILE_DIST_DIR=
# PORTAL_DIST_DIR=
# SMTP credentials (not needed for Mailpit).
# SMTP_USER=
# SMTP_PASSWORD=
# Log level (default info).
# LOG_LEVEL=info
# Set to 1 to run the Vite dev servers over HTTPS.
# DEV_HTTPS=1
# Sentry: the project's DSN. Empty: Sentry is off (the default locally).
SENTRY_DSN=
# production, staging or development (default development). Names the environment in Sentry.
PADVINDER_ENVIRONMENT=development
