{
  "name": "padvinder",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:generated && pnpm test",
    "check:generated": "node scripts/check-generated.ts",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:https": "DEV_HTTPS=1 pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "release:build": "./scripts/build-release.sh",
    "release:image": "./scripts/release-image.sh",
    "release:smoke": "./scripts/release-smoke.sh",
    "test:e2e": "playwright test",
    "test:visual": "vitest run --config packages/ui/vitest.visual.config.ts",
    "test:visual:docker": "./scripts/visual-tests.sh",
    "screenshots:update": "./scripts/visual-tests.sh --update",
    "icons:generate": "pnpm --filter @padvinder/portal icons:generate",
    "db:generate": "pnpm --filter @padvinder/db db:generate",
    "db:migrate": "pnpm --filter @padvinder/db db:migrate",
    "db:seed": "pnpm --filter @padvinder/db db:seed",
    "api:generate": "pnpm --filter @padvinder/api exec tsx src/openapi/write-openapi.ts && pnpm --filter @padvinder/api-client generate",
    "storybook": "pnpm --filter @padvinder/ui storybook",
    "storybook:build": "pnpm --filter @padvinder/ui storybook:build"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.21.0"
}
